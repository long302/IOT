PORT=3001

# URL của ThingsBoard, ví dụ http://localhost:8080
TB_URL=http://localhost:8080

# API Key chỉ lưu ở backend, tuyệt đối không đặt trong client/.env
TB_API_KEY=YOUR_API_KEY

# Production: khai báo chính xác origin frontend, phân cách bằng dấu phẩy.
# Development tự chấp nhận localhost, 127.0.0.1 và ::1 trên mọi cổng.
CORS_ORIGIN=http://localhost:5173

# AI fire detection service; keep its key in this server-side file.
AI_API_URL=https://ai-fire-detection-api.onrender.com
AI_API_KEY=YOUR_API_KEY
